@startuml momo_uf_03_main
title momo 유저플로우 - 03 메인 지도 (장면 A)
skinparam shadowing false
skinparam activity {
  BackgroundColor #FFF9F1
  BorderColor #EE8F8F
  DiamondBackgroundColor #FFF1EF
}

start
:S-10 메인 지도\n오늘 / 근처 3km / 유효 마커\n시간 익음 3단 / 겹치면 익은 것 위;

if (행동?) then (필터)
  :필터 칩 적용\n전체 / 밥 / 운동 / 카공 / 이동;
  :S-10 갱신;
elseif (점 탭?) then (예)
  :S-11 미리보기 카드;
  if (카드에서?) then (상세)
    :S-30 상세;
  else (참여하기)
    :S-31 위치 동의;
  endif
elseif (점 0개?) then (예)
  :S-12 빈 지도 CTA;
  :첫 번개 만들기;
  :S-20;
elseif (+ 만들기?) then (예)
  :S-20 만들기 종류;
elseif (복숭아?) then (예)
  :S-14 복숭아 시트;
else (메뉴)
  :S-13 프로필 / 내 모임 / 로그아웃;
endif
stop
@enduml

