@startuml momo_uf_05_create
title momo 유저플로우 — 05 번개 만들기 (장면 B~E)
skinparam shadowing false
skinparam activity {
  BackgroundColor #FFF9F1
  BorderColor #EE8F8F
  DiamondBackgroundColor #FFF1EF
}

start
:S-20 종류 선택\nmeal / sports / study / taxi;
:S-21 제목·인원·시작(오늘);
if (이동 taxi?) then (예)
  :S-23 지금 / 예약;
  if (지금?) then (예)
    :도착지\n검색·지도·즐겨찾기≤5;
    :모집 타이머 30~60초 UI;
    :면책: 유상운송 아님;
  else (예약)
    :출발 시각 + 도착지;
  endif
else (아니오)
endif
:S-22 만날 장소\n(지도 반 + 시트);
note right
  밥·카페 미정이면
  기본 탭 = 추천 (장면 E)
end note
:S-24 확인·생성;
:S-10 지도에 내 점·카메라 이동;
stop
@enduml

@startuml momo_uf_06_place
title momo 유저플로우 - 06 만날 장소 (장면 C)
skinparam shadowing false
skinparam activity {
  BackgroundColor #FFF9F1
  BorderColor #EE8F8F
  DiamondBackgroundColor #FFF1EF
}

' 참고: partition + elseif + 중첩 if + 중간 stop 조합은
' PlantUML이 파티션 이후 노드를 그리지 못하거나 잘리는 경우가 많음.
' 그래서 partition 없이 평탄한 if 로 작성함.

start
:S-22 장소 단계;

if (시트 탭?) then (직접 지정)
  :길게 누르기 / 검색;
  :핀 확정 후보;
elseif (추천?) then (예)
  :추천 로딩 (스켈레톤 3);
  if (추천 실패?) then (예)
    :직접만 가능\n만들기는 막지 않음;
  else (성공)
    :후보 선택\n이름 / 이유 / 도보 분;
    :지도 카메라 이동;
  endif
else (다른 곳 제안 / 스냅)
  :부적절 핀 감지;
  :대안 카드 표시;
endif

if (택시 골목 등 부적절 핀?) then (예)
  :경고 다이얼로그;
  if (사용자 선택?) then (그래도 여기로)
    :호스트 지정 표시;
  else (추천 보기)
    :추천 탭으로 돌아감;
    kill
  endif
else (아니오)
endif

:이 장소로 정하기;
:확정 핀 1개;
:S-24 확인으로;
stop
@enduml

@startuml momo_uf_07_detail_join
title momo 유저플로우 — 07 상세·참여·진행 (장면 F)
skinparam shadowing false
skinparam activity {
  BackgroundColor #FFF9F1
  BorderColor #EE8F8F
  DiamondBackgroundColor #FFF1EF
}

start
:S-30 상세\n제목·종류·시간·장소·인원·호스트;
if (역할·상태?) then (게스트·참여하기)
  if (정원 참?) then (예)
    :참여 비활성;
    stop
  else (아니오)
    :S-31 위치 동의\n백그라운드 전송 고지;
    if (동의?) then (예)
      :참여 처리·푸시 P1(호스트);
      :S-40 합류;
      stop
    else (거부)
      :참여 가능·합류에 위치 없음;
      stop
    endif
  endif
elseif (이미 참여) then
  if (선택?) then (합류 보기)
    :S-40;
    stop
  else (채팅)
    :S-41;
    stop
  endif
elseif (호스트·진행 N>=2) then
  :모집 잠금;
  :푸시 P2;
  :합류/라이브;
  stop
elseif (호스트·취소) then
  :푸시 P7;
  :위치 OFF·채팅 읽기만;
  stop
else (호스트·수정)
  :장소/시간 변경·푸시 P6;
  stop
endif
@enduml

@startuml momo_uf_08_rendezvous
title momo 유저플로우 - 08 합류 (장면 G)
skinparam shadowing false
skinparam activity {
  BackgroundColor #FFF9F1
  BorderColor #EE8F8F
  DiamondBackgroundColor #FFF1EF
}

start
:S-40 합류 지도\n집결 핀 + 사람 마커;
:OS 알림: 합류 위치 공유 중;
:15초마다 좌표 POST\n(앱 백그라운드여도 전송);
:서버: 거리 / 상태 / 거리 익음;
:UI 갱신\n500m+ / 200~500 / 50~200 / 도착;

if (사용자 상황?) then (채팅)
  :S-41;
elseif (GPS 약함?) then (예)
  :배너: 마지막 위치 표시 중;
elseif (응답 없음?) then (예)
  :상태 응답 없음;
else (종료 / 나가기)
  :좌표 삭제;
  :모임이 끝났어요;
endif
stop
@enduml

@startuml momo_uf_09_chat
title momo 유저플로우 — 09 채팅·신고
skinparam shadowing false
skinparam activity {
  BackgroundColor #FFF9F1
  BorderColor #EE8F8F
  DiamondBackgroundColor #FFF1EF
}

start
:S-41 채팅;
if (모임 상태?) then (ended/cancelled)
  :읽기만;
  stop
else (진행 중)
  if (전송?) then (텍스트)
    :전송·푸시 P3;
  elseif (이미지) then
    if (업로드 성공?) then (예)
      :전송·푸시 P3;
    else (아니오)
      :토스트·텍스트는 유지 가능;
    endif
  else (신고)
    :S-42 신고;
  endif
  stop
endif
@enduml

@startuml momo_uf_10_taxi_now_timer
title momo 유저플로우 — 10 이동·지금 모집 타이머
skinparam shadowing false
skinparam activity {
  BackgroundColor #FFF9F1
  BorderColor #EE8F8F
  DiamondBackgroundColor #FFF1EF
}

start
:이동·지금 번개 생성됨;
:모집 타이머 30~60초;
if (타이머 중?) then (참여 발생)
  :푸시 P1;
elseif (호스트가 N>=2로 진행) then
  :잠금·합류;
  stop
else (타이머 종료)
  :자동 출발 아님;
  :푸시 P8 → 호스트;
  if (호스트 진행 N>=2?) then (예)
    :잠금·합류;
    stop
  else (아니오·취소 등)
    :모집 종료/취소 처리;
    stop
  endif
endif
stop
@enduml

@startuml momo_uf_11_demo_loop
title momo 유저플로우 — 11 MVP 한 바퀴 (성공 기준)
skinparam shadowing false
skinparam activity {
  BackgroundColor #FFF9F1
  BorderColor #EE8F8F
